{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigorsync.local/configs/issues/schema.json",
  "title": "VigorSync issue catalog",
  "type": "object",
  "required": ["schema_version", "exercise", "issues"],
  "properties": {
    "schema_version": {
      "const": "vigorsync-issue-catalog-v1"
    },
    "exercise": {
      "enum": ["squat", "pushup"]
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "family",
          "title",
          "short_cue",
          "correction",
          "detail",
          "default_severity",
          "live_joints",
          "offline_joints",
          "views",
          "live_supported",
          "offline_supported",
          "offline_metrics",
          "limitation"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(squat|pushup)_[a-z0-9_]+$"
          },
          "family": {
            "enum": [
              "depth",
              "torso_control",
              "knee_alignment",
              "symmetry",
              "tempo",
              "stability"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "short_cue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "correction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "default_severity": {
            "enum": ["low", "medium", "high"]
          },
          "live_joints": {
            "$ref": "#/$defs/joints"
          },
          "offline_joints": {
            "$ref": "#/$defs/joints"
          },
          "views": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "front",
                "rear",
                "side_left",
                "side_right",
                "oblique_left",
                "oblique_right",
                "any"
              ]
            }
          },
          "live_supported": {
            "type": "boolean"
          },
          "offline_supported": {
            "type": "boolean"
          },
          "offline_metrics": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "joints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "left_shoulder",
          "right_shoulder",
          "left_elbow",
          "right_elbow",
          "left_wrist",
          "right_wrist",
          "left_hip",
          "right_hip",
          "left_knee",
          "right_knee",
          "left_ankle",
          "right_ankle"
        ]
      }
    }
  }
}
